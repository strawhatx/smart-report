@page "/reports/{id:guid}"
@model SmartReport.App.Pages.Reports.ViewModel
@{
    ViewData["Title"] = Model.Title;
}
@section Head { <link rel="stylesheet" href="~/css/reports.css" /> }

@if (Model.Principal is null)
{
    <div class="shell gallery"><p class="gallery__empty">Sign in from the development banner above.</p></div>
}
else
{
    @await Html.PartialAsync("_Workspace", (SmartReport.App.Pages.Reports.WorkspaceModel)Model)
}

@section Scripts {
    <script src="~/lib/gsap/gsap.min.js" defer></script>
    <script type="module" src="~/js/reports/workspace.js"></script>
}
