@page
@model IndexModel
@{
    ViewData["Title"] = "Order fulfillment for online brands";
}

<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">

    <section class="grid items-center gap-12 py-14 lg:grid-cols-2 lg:gap-16 lg:py-24">
        <div>
            <p class="label-mono">Order fulfillment since 2011</p>
            <h1 class="mt-5 text-[clamp(2.25rem,6vw,3.75rem)] font-bold leading-[1.04]">
                We store, pack and ship orders for online brands.
            </h1>
            <p class="mt-6 max-w-xl text-[17px] leading-7 text-ink-soft">
                340 brands trust Northpoint with their inventory. Orders from Shopify, Amazon and
                wholesale ship same day from three warehouses.
            </p>
            <div class="mt-8 flex flex-wrap gap-3">
                <a href="/portal/reports" class="rounded-lg bg-brand px-5 py-3 text-[15px] font-semibold text-white hover:bg-brand-dark">
                    Get a quote
                </a>
                <span class="rounded-lg border border-rule-strong bg-surface px-5 py-3 text-[15px] font-semibold cursor-default">
                    How it works
                </span>
            </div>
        </div>

        @* Decorative: warehouse bays, not data. Hidden from assistive tech. *@
        <div class="rounded-[22px] bg-sunk p-5 sm:p-7" aria-hidden="true">
            <div class="grid grid-cols-3 gap-4">
                <div class="aspect-4/3 rounded-xl bg-surface"></div>
                <div class="aspect-4/3 rounded-xl bg-brand"></div>
                <div class="aspect-4/3 rounded-xl bg-surface"></div>
                <div class="aspect-4/3 rounded-xl bg-series-4"></div>
                <div class="aspect-4/3 rounded-xl bg-surface"></div>
                <div class="aspect-4/3 rounded-xl bg-[#c4b294]"></div>
            </div>
        </div>
    </section>

    <section class="mb-16 rounded-[22px] bg-ink px-6 py-10 text-paper sm:px-10 lg:mb-24">
        <div class="flex flex-col gap-8 lg:flex-row lg:items-center lg:justify-between">
            <div class="max-w-2xl">
                <p class="label-mono !text-paper/55">For our clients</p>
                <h2 class="mt-3 text-[clamp(1.5rem,3.2vw,2rem)] font-bold leading-tight">
                    Smart Reports: ask about your orders, get the report.
                </h2>
                <p class="mt-4 text-[15px] leading-7 text-paper/70">
                    Shipping, inventory, returns and fees, built from your own data in seconds. No more
                    emailing us for a spreadsheet. You only ever see your own account.
                </p>
            </div>
            <a href="/portal/reports"
               class="shrink-0 self-start rounded-lg bg-surface px-6 py-3.5 text-[15px] font-semibold text-ink hover:bg-paper lg:self-auto">
                Open client reports
            </a>
        </div>
    </section>

</div>
