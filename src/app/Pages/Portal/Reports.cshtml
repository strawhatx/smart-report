@page "/portal/reports"
@model SmartReport.App.Pages.Portal.ReportsModel
@{
    Layout = "_PortalLayout";
}

@if (Model.Principal is null)
{
    <div class="grid flex-1 place-items-center p-10 text-center">
        <p class="max-w-sm text-ink-soft">Pick a user above to sign in to the Trailhead Coffee portal.</p>
    </div>
}
else
{
<div class="grid min-h-0 flex-1 lg:grid-cols-[minmax(320px,380px)_1fr]">

    @* ── Left: the conversation. Everything the pipeline decides lands here, in order. ── *@
    <aside class="flex min-h-0 flex-col border-b border-rule bg-paper/60 lg:border-b-0 lg:border-r"
           aria-label="Conversation">

        @* Capped on a phone so the report is not pushed off the screen by the transcript;
           on a wide screen the rail owns its own column and can run the full height. *@
        <ol id="stream" class="max-h-[38vh] min-h-0 flex-1 space-y-3 overflow-y-auto p-4 sm:p-5 lg:max-h-none"
            aria-live="polite" aria-relevant="additions">
            <li class="text-[14px] leading-6 text-ink-faint">
                Ask in your own words — shipping, inventory, returns, fees, or how you compare to
                other Northpoint clients. Every answer shows the queries it ran and whose data
                they touched.
            </li>
        </ol>

        <form id="ask-form" class="border-t border-rule bg-surface p-4 sm:p-5" autocomplete="off">
            <label for="ask-input" class="label-mono">Ask</label>
            <div class="mt-2 rounded-xl border border-rule-strong bg-surface focus-within:border-brand">
                <textarea id="ask-input" name="question" rows="2" maxlength="500"
                          placeholder="Ask anything about your account — &quot;which carrier is letting us down?&quot;"
                          class="w-full resize-none rounded-xl bg-transparent px-3 py-2.5 text-[15px] outline-none placeholder:text-ink-faint">@Model.Question</textarea>
                <div class="flex items-center justify-between gap-2 px-3 pb-2.5">
                    <span class="text-[12px] text-ink-faint">Enter to ask</span>
                    <button type="submit" id="ask-submit"
                            class="grid size-9 place-items-center rounded-full bg-ink text-paper hover:bg-ink-soft disabled:opacity-40"
                            aria-label="Ask">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="size-4">
                            <path d="M12 19V5M5 12l7-7 7 7" stroke-linecap="round" stroke-linejoin="round"/>
                        </svg>
                    </button>
                </div>
            </div>
        </form>
    </aside>

    @* ── Right: the report. ── *@
    <section id="canvas" class="min-h-0 overflow-y-auto" aria-label="Report">
        <div class="flex flex-wrap items-start justify-between gap-4 px-4 pt-5 sm:px-7">
            <div>
                <h1 id="report-title" class="text-[clamp(1.35rem,3vw,1.6rem)] font-bold leading-tight">
                    @Model.Title
                </h1>
                <p id="report-subtitle" class="mt-1 text-[14px] text-ink-faint">
                    @Model.Principal.ClientName · ask a question to build a report
                </p>
            </div>
            <div class="flex gap-2">
                <button type="button" id="export-csv" disabled
                        class="rounded-lg border border-rule-strong px-4 py-2 text-[14px] font-semibold hover:border-ink-faint disabled:opacity-40">
                    Export
                </button>
                <button type="button" id="save-report" disabled
                        class="rounded-lg bg-brand px-4 py-2 text-[14px] font-semibold text-white hover:bg-brand-dark disabled:opacity-40">
                    Save report
                </button>
            </div>
        </div>

        <div id="canvas-body" class="px-4 py-5 sm:px-7"></div>
    </section>
</div>
}

@section Scripts {
    <script type="module" src="~/js/portal/workspace.js" asp-append-version="true"></script>
}
