# Copy to .env before `docker compose -f docker-compose.local.yml up -d`:
#   cp .env.example .env   &&   then fill in your own values
#
# .env is git-ignored. Do not put real credentials in this example file (C2).

# --- Owner / superuser. Migrations and the seeder only; never request handling (D4).
POSTGRES_USER=smartreport
POSTGRES_PASSWORD=
POSTGRES_DB=smartreport
POSTGRES_PORT=5432

# --- Non-owner application role. Everything the web app does runs as this (A6).
APP_DB_USER=smartreport_app
APP_DB_PASSWORD=
